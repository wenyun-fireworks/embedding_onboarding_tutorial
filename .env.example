# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Create a key in the Fireworks dashboard (https://app.fireworks.ai) for your account.
FIREWORKS_API_KEY=fw_xxxxxxxxxxxxxxxxxxxxxxxx
FIREWORKS_BASE_URL=https://api.fireworks.ai

# Your own Fireworks account id (the part after accounts/ in resource names).
# The fine-tuned model you create lands in this account.
FIREWORKS_ACCOUNT_ID=your-account-id

# ID the tutorial creates in your own account. Change the prefix to taste.
# The trainer promotes the fine-tuned checkpoint to this model (step 2). It comes
# out Kind=EMBEDDING_MODEL, inherited from BASE_MODEL, so it is deployed directly
# in step 3 — no download + re-upload.
TRAINED_MODEL_ID=qwen3-finetuned
# filled in after step 3: firectl list deployments -a $FIREWORKS_ACCOUNT_ID
DEPLOYMENT_ID=

# Training (step 2). BASE_MODEL is a public embedding base (Kind=EMBEDDING_MODEL,
# owned by pyroworks). The kind matters: a FULL-PARAMETER fine-tune of an
# EMBEDDING_MODEL base is promoted as EMBEDDING_MODEL too, which is what lets
# step 3 deploy it straight onto the embedding serving path. With LORA_RANK > 0
# the output is a PEFT addon instead and this shortcut does not apply.
# Leave TRAINING_SHAPE empty so the SDK selects a current, compatible validated
# shape. Pin it only if Fireworks gives you a shape whose snapshot base_model
# matches BASE_MODEL. See README Step 0 for all three sizes.
# TOKENIZER_MODEL must be the corresponding Qwen3-EMBEDDING
# tokenizer (Qwen/Qwen3-Embedding-<size>): its post-processor appends
# <|endoftext|> with add_special_tokens=True, so the recipe's pooling="last"
# trains on the EOS token — matching the embedding serving path (steps 2 and 4
# auto-map a base-LM name like Qwen/Qwen3-8B -> Qwen/Qwen3-Embedding-8B).
BASE_MODEL=accounts/pyroworks/models/qwen3-embedding-8b-ft-base
TOKENIZER_MODEL=Qwen/Qwen3-Embedding-8B
TRAINING_SHAPE=
EPOCHS=15
BATCH_SIZE=8

# Deploy (step 3). Embedding DEPLOYMENT SHAPE (validated preset owned by
# accounts/fireworks, named ...-minimal). This routes the model to the embedding
# serving path that appends <|endoftext|> + last-token pooling to match training;
# it also selects the GPU/precision. Pick the shape for your size (README Step 0):
#   0.6B -> accounts/fireworks/deploymentShapes/qwen3-embedding-0p6b-minimal
#   4B   -> accounts/fireworks/deploymentShapes/qwen3-embedding-4b-minimal
#   8B   -> accounts/fireworks/deploymentShapes/qwen3-embedding-8b-minimal
DEPLOYMENT_SHAPE=accounts/fireworks/deploymentShapes/qwen3-embedding-8b-minimal
# Placement: leave REGION empty for GLOBAL (required if your account holds global
# rather than region-scoped GPU quota). Set a same-cloud region (e.g. us-iowa-1,
# co-located with GCS model artifacts) only if you have region-scoped quota.
REGION=

# Test (step 4). Baseline for the base-vs-fine-tuned comparison: a strong
# off-the-shelf model that IS served on serverless /v1/embeddings (NOT the
# tunable training BASE_MODEL above). Overridable/optional.
# EVAL_BASE_MODEL=accounts/fireworks/models/qwen3-embedding-8b

# Local paths the scripts need (or export them instead):
# COOKBOOK_DIR=/path/to/cookbook          # your clone of https://github.com/fw-ai/cookbook (step 2)
# PY=/path/to/venv/bin/python             # the python where you installed the deps
